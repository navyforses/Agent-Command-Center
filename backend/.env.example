# Trial Navigator Environment Variables
# Copy this file to .env and fill in your values

# ======================
# Database (Supabase)
# ======================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ======================
# OpenAI (Translation)
# ======================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ======================
# Anthropic (Fallback/Patient Profile Analysis)
# ======================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ======================
# Email (Resend)
# ======================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key-here
FROM_EMAIL=noreply@yourdomain.com

# ======================
# Payments (Stripe)
# ======================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# ======================
# Application
# ======================
APP_URL=http://localhost:8000
SECRET_KEY=your-random-secret-key-change-in-production
DEBUG=true

# ======================
# Rate Limits (requests per second)
# ======================
CLINICALTRIALS_GOV_RATE_LIMIT=3.0
PUBMED_RATE_LIMIT=3.0
