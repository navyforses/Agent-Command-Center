# =============================================
# Trial Navigator - Environment Variables Template
# =============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# See docs/ENV_VARIABLES.md for detailed documentation

# === DATABASE (Required) ===
DATABASE_URL=postgresql://user:password@localhost:5432/trial_navigator

# === AUTHENTICATION (Required) ===
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long
REPL_ID=your-replit-application-id
ISSUER_URL=https://replit.com/oidc

# === AI APIs (At least one required for AI features) ===

# OpenAI (GPT-4) - https://platform.openai.com/api-keys
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude) - https://console.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini - https://aistudio.google.com/app/apikey
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-key
AI_INTEGRATIONS_GEMINI_BASE_URL=
GEMINI_API_KEY=your-gemini-key

# X.AI (Grok) - https://x.ai
XAI_API_KEY=xai-your-xai-key

# Perplexity - https://perplexity.ai
PERPLEXITY_API_KEY=pplx-your-perplexity-key

# === SEARCH APIs (Optional) ===
TAVILY_API_KEY=tvly-your-tavily-key
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_CX=your-custom-search-engine-id

# === MEDICAL APIs (Optional) ===
PUBMED_API_KEY=your-ncbi-pubmed-api-key
OPENFDA_API_KEY=your-openfda-api-key

# === EMAIL (Optional - Required for email features) ===
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# === VECTOR DATABASE (Optional - For PROMETHEUS Phase 2) ===
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=prometheus-mind

# === STORAGE (Optional) ===
PUBLIC_OBJECT_SEARCH_PATHS=/uploads,/public
PRIVATE_OBJECT_DIR=/private

# === SECURITY (Optional - Auto-generated if not set) ===
CLINICAL_ENCRYPTION_KEY=your-64-character-hex-encryption-key

# === ERROR TRACKING (Optional) ===
SENTRY_DSN=your-sentry-dsn-here

# === RUNTIME ===
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0
