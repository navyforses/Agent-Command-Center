# Database Configuration (Required)
# For Replit: This is auto-provisioned
# For local dev: Use your PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/agent_command_center

# Session Secret (Required)
SESSION_SECRET=your-super-secret-session-key-here

# OpenAI API (Required for AI features)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (Optional)
AI_INTEGRATIONS_GEMINI_API_KEY=your-gemini-key
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Anthropic Claude (Optional)
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your-anthropic-key
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Grok/xAI (Optional)
XAI_API_KEY=your-xai-key

# Perplexity (Optional)
PERPLEXITY_API_KEY=your-perplexity-key

# Search APIs (Optional)
TAVILY_API_KEY=your-tavily-key
GOOGLE_SEARCH_API_KEY=your-google-search-key
GOOGLE_SEARCH_CX=your-search-engine-id

# Email Service (Required for email features)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Server Configuration
PORT=5000
NODE_ENV=development

# Replit Auth (Auto-configured in Replit)
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com
